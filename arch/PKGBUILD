# Maintainer: justforlxz <justforlxz@gmail.com>
pkgname=dtk6core-git
pkgver=6.0.48
pkgrel=1
pkgdesc='DTK6 core modules'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/dtk6core"
license=('LGPL-3.0-or-later' 'LGPL-2.1-or-later' 'BSD-3-Clause')
# 官方源的 dtkcommon/dtk6log 版本不同，必须依赖 GXDE 的 -git 包
# Official repos ship different dtkcommon/dtk6log, depend on the GXDE -git packages explicitly.
# icu/uchardet 由 QLibrary 在运行时加载，lshw 被 DSysInfo 调用
# icu/uchardet are loaded at runtime via QLibrary, lshw is invoked by DSysInfo.
depends=('dtkcommon-git' 'dtk6log-git' 'qt6-base' 'icu' 'uchardet' 'dbus' 'lshw' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
provides=("dtk6core=$pkgver")
conflicts=('dtk6core')
groups=('deepin-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DMKSPECS_INSTALL_DIR=lib/qt6/mkspecs/modules \
    -DFEATURES_INSTALL_DIR=lib/qt6/mkspecs/features \
    -DBUILD_WITH_SYSTEMD=ON \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_DOCS=OFF \
    -DD_DSG_APP_DATA_FALLBACK=/var/dsg/appdata
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 "$(_srcroot)/LICENSES/BSD-3-Clause.txt" "$pkgdir/usr/share/licenses/$pkgname/BSD-3-Clause.txt"
}
